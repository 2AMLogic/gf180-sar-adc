+ tie_sel_hi_n_16n tie_sel_lo_n_16n tie_rel_n_8n tie_sel_hi_n_8n
+ tie_sel_lo_n_8n tie_rel_n_4n tie_sel_hi_n_4n tie_sel_lo_n_4n
+ tie_rel_n_2n tie_sel_hi_n_2n tie_sel_lo_n_2n tie_rel_n_1n
+ tie_sel_hi_n_1n tie_sel_lo_n_1n sar_ctrl_a
stiep tie_vinp tie_shp tie_samp_tp_n 0 sarl_sw
stien tie_vinn tie_shn tie_samp_tp_n 0 sarl_sw
ctiep tie_shp 0 1p
ctien tie_shn 0 1p
rtiesd tie_samp_tp_n tie_sampd 10k
ctiesd tie_sampd 0 1p
stiexp tie_vinp tie_shxp tie_sampd 0 sarl_sw
stiexn tie_vinn tie_shxn tie_sampd 0 sarl_sw
ctiexp tie_shxp 0 1p
ctiexn tie_shxn 0 1p
btietopp tie_topip 0 V = 2*vcm-v(tie_shp)+(1.0/512)*(
+ 256*((v(tie_rel_n_256p)*vcm+v(tie_sel_hi_n_256p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 128*((v(tie_rel_n_128p)*vcm+v(tie_sel_hi_n_128p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 64*((v(tie_rel_n_64p)*vcm+v(tie_sel_hi_n_64p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 32*((v(tie_rel_n_32p)*vcm+v(tie_sel_hi_n_32p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 16*((v(tie_rel_n_16p)*vcm+v(tie_sel_hi_n_16p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 8*((v(tie_rel_n_8p)*vcm+v(tie_sel_hi_n_8p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 4*((v(tie_rel_n_4p)*vcm+v(tie_sel_hi_n_4p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 2*((v(tie_rel_n_2p)*vcm+v(tie_sel_hi_n_2p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) + 1*((v(tie_rel_n_1p)*vcm+v(tie_sel_hi_n_1p)*vref+v(tie_sel_in_n)*v(tie_vinp))/vdd_val-vcm) )
btietopn tie_topin 0 V = 2*vcm-v(tie_shn)+(1.0/512)*(
+ 256*((v(tie_rel_n_256n)*vcm+v(tie_sel_hi_n_256n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 128*((v(tie_rel_n_128n)*vcm+v(tie_sel_hi_n_128n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 64*((v(tie_rel_n_64n)*vcm+v(tie_sel_hi_n_64n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 32*((v(tie_rel_n_32n)*vcm+v(tie_sel_hi_n_32n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 16*((v(tie_rel_n_16n)*vcm+v(tie_sel_hi_n_16n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 8*((v(tie_rel_n_8n)*vcm+v(tie_sel_hi_n_8n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 4*((v(tie_rel_n_4n)*vcm+v(tie_sel_hi_n_4n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 2*((v(tie_rel_n_2n)*vcm+v(tie_sel_hi_n_2n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) + 1*((v(tie_rel_n_1n)*vcm+v(tie_sel_hi_n_1n)*vref+v(tie_sel_in_n)*v(tie_vinn))/vdd_val-vcm) )
rtiep tie_topip tie_topp 1k
rtien tie_topin tie_topn 1k
ctietp tie_topp 0 2.56p
ctietn tie_topn 0 2.56p
btiecmp tie_cmpd 0 V = v(tie_topp) > v(tie_topn) ? vdd_val : 0
rtiecmps tie_cmpd tie_cmpo 1k
ctiecmpl tie_cmpo 0 100f
btiecode tie_code 0 V = 
+ (512)*(v(tie_c9)>vth ? 1 : 0) + (256)*(v(tie_c8)>vth ? 1 : 0) + (128)*(v(tie_c7)>vth ? 1 : 0) + (64)*(v(tie_c6)>vth ? 1 : 0) + (32)*(v(tie_c5)>vth ? 1 : 0) + (16)*(v(tie_c4)>vth ? 1 : 0) + (8)*(v(tie_c3)>vth ? 1 : 0) + (4)*(v(tie_c2)>vth ? 1 : 0) + (2)*(v(tie_c1)>vth ? 1 : 0) + (1)*(v(tie_c0)>vth ? 1 : 0)
btiedrdyb tie_drdyb 0 V = v(tie_drdy)>vth ? vdd_val : 0
rtiedrdyg tie_drdyb tie_drdyg 1k
ctiedrdyg tie_drdyg 0 721.348f
btieconf tie_conf 0 V = (
+ abs(v(tie_sel_in_n)+v(tie_rel_n_256p)+v(tie_sel_hi_n_256p)+v(tie_sel_lo_n_256p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_128p)+v(tie_sel_hi_n_128p)+v(tie_sel_lo_n_128p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_64p)+v(tie_sel_hi_n_64p)+v(tie_sel_lo_n_64p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_32p)+v(tie_sel_hi_n_32p)+v(tie_sel_lo_n_32p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_16p)+v(tie_sel_hi_n_16p)+v(tie_sel_lo_n_16p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_8p)+v(tie_sel_hi_n_8p)+v(tie_sel_lo_n_8p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_4p)+v(tie_sel_hi_n_4p)+v(tie_sel_lo_n_4p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_2p)+v(tie_sel_hi_n_2p)+v(tie_sel_lo_n_2p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_1p)+v(tie_sel_hi_n_1p)+v(tie_sel_lo_n_1p)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_256n)+v(tie_sel_hi_n_256n)+v(tie_sel_lo_n_256n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_128n)+v(tie_sel_hi_n_128n)+v(tie_sel_lo_n_128n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_64n)+v(tie_sel_hi_n_64n)+v(tie_sel_lo_n_64n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_32n)+v(tie_sel_hi_n_32n)+v(tie_sel_lo_n_32n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_16n)+v(tie_sel_hi_n_16n)+v(tie_sel_lo_n_16n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_8n)+v(tie_sel_hi_n_8n)+v(tie_sel_lo_n_8n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_4n)+v(tie_sel_hi_n_4n)+v(tie_sel_lo_n_4n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_2n)+v(tie_sel_hi_n_2n)+v(tie_sel_lo_n_2n)-vdd_val) + abs(v(tie_sel_in_n)+v(tie_rel_n_1n)+v(tie_sel_hi_n_1n)+v(tie_sel_lo_n_1n)-vdd_val))/vdd_val
