* ---- d70: rd = 0.70 dummy at DR-0001's contracted 500 ohm ----
Rs_d70_f00 nin_f00 ni_d70_f00 500
Xsw_d70_f00 ni_d70_f00 no_d70_f00 nclk nclkb vdd tgate_dum wn=40u wp=80u rd=0.7
XCl_d70_f00 no_d70_f00 0 mim_cap_2f0 c_width=66.36u c_length=66.36u
