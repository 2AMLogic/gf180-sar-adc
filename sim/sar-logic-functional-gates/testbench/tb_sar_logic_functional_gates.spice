+ abs(v(df_sel_in_n)+v(df_rel_n_256p)+v(df_sel_hi_n_256p)+v(df_sel_lo_n_256p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_128p)+v(df_sel_hi_n_128p)+v(df_sel_lo_n_128p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_64p)+v(df_sel_hi_n_64p)+v(df_sel_lo_n_64p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_32p)+v(df_sel_hi_n_32p)+v(df_sel_lo_n_32p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_16p)+v(df_sel_hi_n_16p)+v(df_sel_lo_n_16p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_8p)+v(df_sel_hi_n_8p)+v(df_sel_lo_n_8p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_4p)+v(df_sel_hi_n_4p)+v(df_sel_lo_n_4p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_2p)+v(df_sel_hi_n_2p)+v(df_sel_lo_n_2p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_1p)+v(df_sel_hi_n_1p)+v(df_sel_lo_n_1p)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_256n)+v(df_sel_hi_n_256n)+v(df_sel_lo_n_256n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_128n)+v(df_sel_hi_n_128n)+v(df_sel_lo_n_128n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_64n)+v(df_sel_hi_n_64n)+v(df_sel_lo_n_64n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_32n)+v(df_sel_hi_n_32n)+v(df_sel_lo_n_32n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_16n)+v(df_sel_hi_n_16n)+v(df_sel_lo_n_16n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_8n)+v(df_sel_hi_n_8n)+v(df_sel_lo_n_8n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_4n)+v(df_sel_hi_n_4n)+v(df_sel_lo_n_4n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_2n)+v(df_sel_hi_n_2n)+v(df_sel_lo_n_2n)-vdd_val) + abs(v(df_sel_in_n)+v(df_rel_n_1n)+v(df_sel_hi_n_1n)+v(df_sel_lo_n_1n)-vdd_val))/vdd_val
bdfnside df_nside 0 V = (
+ v(df_sel_hi_n_256n)+v(df_sel_lo_n_256n) + v(df_sel_hi_n_128n)+v(df_sel_lo_n_128n) + v(df_sel_hi_n_64n)+v(df_sel_lo_n_64n) + v(df_sel_hi_n_32n)+v(df_sel_lo_n_32n) + v(df_sel_hi_n_16n)+v(df_sel_lo_n_16n) + v(df_sel_hi_n_8n)+v(df_sel_lo_n_8n) + v(df_sel_hi_n_4n)+v(df_sel_lo_n_4n) + v(df_sel_hi_n_2n)+v(df_sel_lo_n_2n) + v(df_sel_hi_n_1n)+v(df_sel_lo_n_1n))/vdd_val
bdfacq df_acq 0 V = v(df_samp_tp_n)/vdd_val
bdfiso df_iso 0 V = (v(df_sel_in_n)-v(df_samp_tp_n))/vdd_val
* differential: both pins swing +-V_REF/2 about V_cm, so the
* differential input covers +-V_REF. Full scale = 2*V_REF,
* LSB = V_REF/512, mid-scale code 512 at zero differential input.
vdfp df_vinp 0 pwl(0 {vcm-vref/2+lsbdf/4} 64000.0n {vcm+vref/2+lsbdf/4})
vdfn df_vinn 0 pwl(0 {vcm+vref/2-lsbdf/4} 64000.0n {vcm-vref/2-lsbdf/4})
bdfexp df_exp 0 V = min(max(512+floor((v(df_shxp)-v(df_shxn))/lsbdf),0),1023)
bdferr df_err 0 V = min(v(df_drdy),v(df_drdyg))>vth ? v(df_code)-v(df_exp) : 0

* Externally-supplied net(s) this subckt's cells bind but nothing
* inside it drives. Without .global, SPICE scopes these LOCALLY to
* each instance -- the DUT would sit unpowered at ~0 V and every
* symptom would read as a solver/power-up problem (issue #282).
.global vdd_gate

