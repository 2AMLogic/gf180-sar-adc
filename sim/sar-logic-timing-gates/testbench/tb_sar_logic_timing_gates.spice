+ abs(v(bad_sel_in_n)+v(bad_rel_n_256p)+v(bad_sel_hi_n_256p)+v(bad_sel_lo_n_256p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_128p)+v(bad_sel_hi_n_128p)+v(bad_sel_lo_n_128p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_64p)+v(bad_sel_hi_n_64p)+v(bad_sel_lo_n_64p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_32p)+v(bad_sel_hi_n_32p)+v(bad_sel_lo_n_32p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_16p)+v(bad_sel_hi_n_16p)+v(bad_sel_lo_n_16p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_8p)+v(bad_sel_hi_n_8p)+v(bad_sel_lo_n_8p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_4p)+v(bad_sel_hi_n_4p)+v(bad_sel_lo_n_4p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_2p)+v(bad_sel_hi_n_2p)+v(bad_sel_lo_n_2p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_1p)+v(bad_sel_hi_n_1p)+v(bad_sel_lo_n_1p)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_256n)+v(bad_sel_hi_n_256n)+v(bad_sel_lo_n_256n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_128n)+v(bad_sel_hi_n_128n)+v(bad_sel_lo_n_128n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_64n)+v(bad_sel_hi_n_64n)+v(bad_sel_lo_n_64n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_32n)+v(bad_sel_hi_n_32n)+v(bad_sel_lo_n_32n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_16n)+v(bad_sel_hi_n_16n)+v(bad_sel_lo_n_16n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_8n)+v(bad_sel_hi_n_8n)+v(bad_sel_lo_n_8n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_4n)+v(bad_sel_hi_n_4n)+v(bad_sel_lo_n_4n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_2n)+v(bad_sel_hi_n_2n)+v(bad_sel_lo_n_2n)-vdd_val) + abs(v(bad_sel_in_n)+v(bad_rel_n_1n)+v(bad_sel_hi_n_1n)+v(bad_sel_lo_n_1n)-vdd_val))/vdd_val
bbadnside bad_nside 0 V = (
+ v(bad_sel_hi_n_256n)+v(bad_sel_lo_n_256n) + v(bad_sel_hi_n_128n)+v(bad_sel_lo_n_128n) + v(bad_sel_hi_n_64n)+v(bad_sel_lo_n_64n) + v(bad_sel_hi_n_32n)+v(bad_sel_lo_n_32n) + v(bad_sel_hi_n_16n)+v(bad_sel_lo_n_16n) + v(bad_sel_hi_n_8n)+v(bad_sel_lo_n_8n) + v(bad_sel_hi_n_4n)+v(bad_sel_lo_n_4n) + v(bad_sel_hi_n_2n)+v(bad_sel_lo_n_2n) + v(bad_sel_hi_n_1n)+v(bad_sel_lo_n_1n))/vdd_val
