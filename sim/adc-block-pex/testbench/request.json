  "measurements": [
    {
      "name": "vres_diff",
      "spice": ".meas tran vres_diff FIND par('v(topp)-v(topn)') AT=145n",
      "unit": "V"
    },
    {
      "name": "vtop_cm",
      "spice": ".meas tran vtop_cm FIND par('(v(topp)+v(topn))/2') AT=145n",
      "unit": "V"
    },
    {
      "name": "dout_end",
      "spice": ".meas tran dout_end FIND v(dout) AT=178n",
      "unit": "V",
