bseconf se_conf 0 V = (
+ abs(v(se_sel_in_n)+v(se_rel_n_256p)+v(se_sel_hi_n_256p)+v(se_sel_lo_n_256p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_128p)+v(se_sel_hi_n_128p)+v(se_sel_lo_n_128p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_64p)+v(se_sel_hi_n_64p)+v(se_sel_lo_n_64p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_32p)+v(se_sel_hi_n_32p)+v(se_sel_lo_n_32p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_16p)+v(se_sel_hi_n_16p)+v(se_sel_lo_n_16p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_8p)+v(se_sel_hi_n_8p)+v(se_sel_lo_n_8p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_4p)+v(se_sel_hi_n_4p)+v(se_sel_lo_n_4p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_2p)+v(se_sel_hi_n_2p)+v(se_sel_lo_n_2p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_1p)+v(se_sel_hi_n_1p)+v(se_sel_lo_n_1p)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_256n)+v(se_sel_hi_n_256n)+v(se_sel_lo_n_256n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_128n)+v(se_sel_hi_n_128n)+v(se_sel_lo_n_128n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_64n)+v(se_sel_hi_n_64n)+v(se_sel_lo_n_64n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_32n)+v(se_sel_hi_n_32n)+v(se_sel_lo_n_32n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_16n)+v(se_sel_hi_n_16n)+v(se_sel_lo_n_16n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_8n)+v(se_sel_hi_n_8n)+v(se_sel_lo_n_8n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_4n)+v(se_sel_hi_n_4n)+v(se_sel_lo_n_4n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_2n)+v(se_sel_hi_n_2n)+v(se_sel_lo_n_2n)-vdd_val) + abs(v(se_sel_in_n)+v(se_rel_n_1n)+v(se_sel_hi_n_1n)+v(se_sel_lo_n_1n)-vdd_val))/vdd_val
